<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="gps_denied_outdoor_lio_vio">
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.70 0.82 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.85 0.75 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <!-- Large textured-like ground. The visual color and small tiles below help VIO;
         the collision plane helps LiDAR/range returns in Gazebo. -->
    <model name="asphalt_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>80 80 0.05</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>80 80 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.22 0.23 0.23 1</ambient>
            <diffuse>0.22 0.23 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Non-repeating ground markings. They are intentionally asymmetric so VIO has
         trackable image features and less repeated-pattern ambiguity. -->
    <model name="ground_feature_markings">
      <static>true</static>
      <link name="link">
        <visual name="stripe_0">
          <pose>-12 -7 0.031 0 0 0.2</pose>
          <geometry><box><size>11 0.25 0.01</size></box></geometry>
          <material><ambient>0.95 0.92 0.25 1</ambient><diffuse>0.95 0.92 0.25 1</diffuse></material>
        </visual>
        <visual name="stripe_1">
          <pose>-5 4 0.032 0 0 -0.35</pose>
          <geometry><box><size>8 0.25 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="stripe_2">
          <pose>7 -3 0.033 0 0 0.75</pose>
          <geometry><box><size>7 0.25 0.01</size></box></geometry>
          <material><ambient>0.1 0.6 0.95 1</ambient><diffuse>0.1 0.6 0.95 1</diffuse></material>
        </visual>
        <visual name="landing_h">
          <pose>0 0 0.034 0 0 0</pose>
          <geometry><box><size>3.0 0.22 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <visual name="landing_v">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry><box><size>0.22 3.0 0.01</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Building walls and corners: strong geometry for LIO and high-contrast
         visual panels for VIO. -->
    <model name="building_block_a">
      <static>true</static>
      <pose>10 8 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 1.0 5.0</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>12 1.0 5.0</size></box></geometry>
          <material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material>
        </visual>
        <visual name="blue_panel"><pose>-3 -0.51 1.0 0 0 0</pose><geometry><box><size>2.0 0.03 1.2</size></box></geometry>
          <material><ambient>0.05 0.25 0.85 1</ambient><diffuse>0.05 0.25 0.85 1</diffuse></material>
        </visual>
        <visual name="red_panel"><pose>2.5 -0.52 0.2 0 0 0</pose><geometry><box><size>1.4 0.03 1.0</size></box></geometry>
          <material><ambient>0.9 0.15 0.12 1</ambient><diffuse>0.9 0.15 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="building_block_b">
      <static>true</static>
      <pose>-11 9 2.0 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 1.0 4.0</size></box></geometry></collision>
        <visual name="wall"><geometry><box><size>10 1.0 4.0</size></box></geometry>
          <material><ambient>0.42 0.46 0.48 1</ambient><diffuse>0.42 0.46 0.48 1</diffuse></material>
        </visual>
        <visual name="yellow_panel"><pose>1.5 -0.51 0.5 0 0 0</pose><geometry><box><size>1.2 0.03 1.2</size></box></geometry>
          <material><ambient>0.95 0.8 0.05 1</ambient><diffuse>0.95 0.8 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Poles, trunks, signs, and boxes give vertical edges for LIO and corners for VIO. -->
    <model name="feature_poles">
      <static>true</static>
      <link name="link">
        <collision name="pole_0_col"><pose>-6 -4 1.75 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>3.5</length></cylinder></geometry></collision>
        <visual name="pole_0_vis"><pose>-6 -4 1.75 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>3.5</length></cylinder></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
        <collision name="pole_1_col"><pose>4 -6 1.5 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="pole_1_vis"><pose>4 -6 1.5 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>3.0</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
        <collision name="tree_0_col"><pose>8 -11 2.0 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="tree_0_vis"><pose>8 -11 2.0 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry><material><ambient>0.35 0.2 0.1 1</ambient><diffuse>0.35 0.2 0.1 1</diffuse></material></visual>
        <visual name="tree_0_crown"><pose>8 -11 4.4 0 0 0</pose><geometry><sphere><radius>1.4</radius></sphere></geometry><material><ambient>0.1 0.35 0.1 1</ambient><diffuse>0.1 0.35 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="feature_boxes">
      <static>true</static>
      <link name="link">
        <collision name="box_0_col"><pose>-3 6 0.75 0 0 0.2</pose><geometry><box><size>2.0 1.2 1.5</size></box></geometry></collision>
        <visual name="box_0_vis"><pose>-3 6 0.75 0 0 0.2</pose><geometry><box><size>2.0 1.2 1.5</size></box></geometry><material><ambient>0.8 0.35 0.1 1</ambient><diffuse>0.8 0.35 0.1 1</diffuse></material></visual>
        <collision name="box_1_col"><pose>5 3 0.55 0 0 -0.5</pose><geometry><box><size>1.4 2.2 1.1</size></box></geometry></collision>
        <visual name="box_1_vis"><pose>5 3 0.55 0 0 -0.5</pose><geometry><box><size>1.4 2.2 1.1</size></box></geometry><material><ambient>0.15 0.55 0.85 1</ambient><diffuse>0.15 0.55 0.85 1</diffuse></material></visual>
        <collision name="sign_col"><pose>-8 2 1.5 0 0 0.4</pose><geometry><box><size>1.8 0.12 1.2</size></box></geometry></collision>
        <visual name="sign_vis"><pose>-8 2 1.5 0 0 0.4</pose><geometry><box><size>1.8 0.12 1.2</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <uri>model://f450_lio_vio_sensor_rig</uri>
      <pose>0 0 0.25 0 0 0</pose>
    </include>
  </world>
</sdf>
