<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="f450_lio_vio_sensor_rig">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry><box><size>0.34 0.34 0.08</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.34 0.34 0.08</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>

      <visual name="front_arm">
        <pose>0.18 0 0 0 0 0</pose>
        <geometry><box><size>0.36 0.035 0.035</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="left_arm">
        <pose>0 0.18 0 0 0 1.5708</pose>
        <geometry><box><size>0.36 0.035 0.035</size></box></geometry>
        <material><ambient>0.1 0.1 0.85 1</ambient><diffuse>0.1 0.1 0.85 1</diffuse></material>
      </visual>
      <visual name="right_arm">
        <pose>0 -0.18 0 0 0 1.5708</pose>
        <geometry><box><size>0.36 0.035 0.035</size></box></geometry>
        <material><ambient>0.1 0.1 0.85 1</ambient><diffuse>0.1 0.1 0.85 1</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/gazebo/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="lidar_3d" type="gpu_lidar">
        <pose>0 0 0.08 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/gazebo/lidar/points</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.43633</min_angle>
              <max_angle>0.43633</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.5</min>
            <max>60.0</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.015</stddev>
          </noise>
        </lidar>
      </sensor>

      <sensor name="stereo_left" type="camera">
        <pose>0.12 0.06 0.03 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/gazebo/stereo/left/image</topic>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image><width>752</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>80</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </camera>
      </sensor>

      <sensor name="stereo_right" type="camera">
        <pose>0.12 -0.06 0.03 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/gazebo/stereo/right/image</topic>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>
          <image><width>752</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>80</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </camera>
      </sensor>

      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0.11 0 0.02 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/gazebo/rgbd</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>30</far></clip>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.006</stddev></noise>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
