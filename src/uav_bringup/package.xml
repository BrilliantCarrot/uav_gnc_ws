<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the UAV GNC stack.</description>
  <maintainer email="leeyj950322@gmail.com">lyj</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>uav_dynamics</exec_depend>
  <exec_depend>uav_control</exec_depend>
  <exec_depend>uav_navigation</exec_depend>
  <exec_depend>uav_guidance</exec_depend>
  <exec_depend>uav_planning</exec_depend>
  <exec_depend>uav_perception</exec_depend>
  <exec_depend>uav_evaluation</exec_depend>
  <exec_depend>uav_visualization</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
